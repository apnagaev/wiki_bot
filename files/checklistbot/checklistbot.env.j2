# {{ ansible_managed }}
BOT_TOKEN={{ checklistbot_telegram_token | replace('$', '$$') }}
SECRET_KEY={{ checklistbot_secret_key | replace('$', '$$') }}
WIKI_URLS={{ checklistbot_wiki_urls | join(',') }}
ALLOWED_TG_IDS={{ checklistbot_allowed_tg_ids | join(',') }}
TELEGRAM_PROXY={{ checklistbot_telegram_proxy | replace('$', '$$') }}
PGHOST={{ checklistbot_db_host }}
PGPORT={{ checklistbot_db_port }}
PGDATABASE={{ checklistbot_db_name }}
PGUSER={{ checklistbot_db_user }}
PGPASSWORD={{ checklistbot_db_password | replace('$', '$$') }}
PGSSLMODE={{ checklistbot_db_sslmode }}
TIMEZONE={{ checklistbot_timezone }}
LOG_LEVEL={{ checklistbot_log_level }}
